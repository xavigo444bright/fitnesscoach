.page {
  min-height: 100vh;
  padding: 96rpx 48rpx 48rpx;
  box-sizing: border-box;
  background: #0f172a;
  color: #f8fafc;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}

.stats {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.issue {
  color: #cbd5e1;
  font-size: 30rpx;
  margin-bottom: 64rpx;
  line-height: 1.5;
}

.muted {
  color: #64748b;
}

.cta {
  background: #3b82f6 !important;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.secondary {
  background: #1e293b !important;
  color: #f8fafc !important;
  border-radius: 16rpx;
}
