.page {
  min-height: 100vh;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  background: #0f172a;
  color: #f8fafc;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 48rpx;
}

.card {
  background: #1e293b;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
}

.card-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.card-meta {
  color: #94a3b8;
  font-size: 28rpx;
}

.hint {
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.dev {
  margin-top: 80rpx;
  text-align: center;
  color: #3b82f6;
  font-size: 26rpx;
}
