.page {
  width: 100%;
  height: 100vh;
  background: #000;
  position: relative;
}

.camera {
  width: 100%;
  height: 100%;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #111;
}

.center {
  padding: 80rpx 48rpx;
  color: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.hint {
  color: #ccc;
  margin-bottom: 48rpx;
}

.hud {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
