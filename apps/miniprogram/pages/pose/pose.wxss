.page {
  width: 100%;
  height: 100vh;
  background: #000;
  position: relative;
  overflow: hidden;
}

.camera,
.overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.hud {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  z-index: 10;
  background: rgba(0, 0, 0, 0.72);
  color: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.title {
  font-weight: 700;
  margin-bottom: 8rpx;
}

.err {
  color: #ff8a80;
  margin-top: 8rpx;
}

.actions {
  margin-top: 16rpx;
}

.tip {
  margin-top: 12rpx;
  color: #aaa;
  font-size: 22rpx;
}
