/**
 * PG-004 训练页样式 — 对齐 docs/design-tokens.md + packages/ui theme
 * 小程序字号按 UI.md §5（相对 App 略小）
 */
.page {
  width: 100%;
  height: 100vh;
  background: #0f172a; /* --color-bg */
  position: relative;
  overflow: hidden;
}

.camera {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 不能加 pointer-events:none：真机上 canvas 原生视图仍会拦触摸，
   但该 CSS 会把 canvas 自己的触摸事件也抑制掉，导致按钮路由收不到事件 */
.overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* CMP-006：大框贴底，底边在 BottomBar 之上。
   4 条边线拼成，避免整块透明区拦截点击（圆角因此舍弃） */
.pf {
  position: absolute;
  box-sizing: border-box;
}

.pf-top {
  left: 3%;
  right: 3%;
  top: 6%;
  height: 2px;
  border-top: 2px dashed rgba(255, 255, 255, 0.85); /* --color-overlay-text */
}

.pf-bottom {
  left: 3%;
  right: 3%;
  bottom: calc(72px + env(safe-area-inset-bottom));
  height: 2px;
  border-bottom: 2px dashed rgba(255, 255, 255, 0.85);
}

.pf-left {
  left: 3%;
  top: 6%;
  bottom: calc(72px + env(safe-area-inset-bottom));
  width: 2px;
  border-left: 2px dashed rgba(255, 255, 255, 0.85);
}

.pf-right {
  right: 3%;
  top: 6%;
  bottom: calc(72px + env(safe-area-inset-bottom));
  width: 2px;
  border-right: 2px dashed rgba(255, 255, 255, 0.85);
}

.cv-perf {
  position: absolute;
  left: 16px;
  right: 16px;
  padding: 8px 12px;
  background-color: rgba(0, 0, 0, 0.55); /* --color-overlay-scrim */
  color: #eab308; /* debug 用 warning 色，非正式反馈 */
  font-size: 12px; /* --font-caption 小程序 */
  text-align: center;
  border-radius: 8px;
}

.cv-perf-reason {
  margin-top: 4px;
  color: #f87171;
  font-size: 11px;
  text-align: left;
  white-space: normal;
  word-break: break-all;
}

.cv-hud {
  position: absolute;
  left: 16px;
  right: 16px;
  padding: 12px 16px;
  background-color: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 14px;
  border-radius: 8px;
}

.cv-feedback {
  position: absolute;
  left: 16px;
  right: 16px;
  min-height: 56px; /* --feedback-bar-min-height */
  padding: 12px 16px;
  background-color: rgba(0, 0, 0, 0.55);
  border-radius: 8px;
  box-sizing: border-box;
}

.cv-fb {
  font-size: 16px; /* --font-feedback 小程序 */
  font-weight: 600;
  color: #ef4444; /* --color-error */
  margin-bottom: 4px;
}

.cv-fb.warn {
  color: #eab308; /* --color-warning */
}

.cv-fb.ok {
  color: #22c55e; /* --color-correct */
}

.cv-place-hint {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: calc(84px + env(safe-area-inset-bottom));
  padding: 10px 16px;
  background-color: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  border-radius: 8px;
}

.cv-err,
.cv-err-bar {
  color: #ef4444;
}

.cv-err-bar {
  position: absolute;
  left: 16px;
  right: 16px;
  top: 120px;
  padding: 8px 12px;
  background-color: rgba(0, 0, 0, 0.55);
  font-size: 12px;
  border-radius: 8px;
}

/* Prepare 风格次要 chip，左侧避开胶囊 */
.cv-flip {
  position: absolute;
  left: 16px;
  min-height: 44px; /* --touch-min */
  min-width: 56px;
  padding: 10px 12px;
  border-radius: 8px; /* --radius-sm */
  background-color: rgba(0, 0, 0, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.35);
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  text-align: center;
  line-height: 24px;
  box-sizing: border-box;
}

/* CMP-005 BottomBar 由 canvas 绘制（canvasOverlay.drawBottomBar），
   cover-view 版会吞掉「结束」的点击 */
