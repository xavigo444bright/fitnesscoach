<view class="page">
  <camera
    wx:if="{{cameraOn}}"
    id="poseCamera"
    class="camera"
    device-position="front"
    flash="off"
    frame-size="small"
    binderror="onCameraError"
  />

  <canvas
    type="2d"
    id="overlay"
    class="overlay"
  />

  <view class="hud">
    <view class="title">M5-T1 · render Canvas</view>
    <view class="perf">{{perfLine}}</view>
    <view>状态: {{status}}</view>
    <view>关键点: {{landmarkCount}} · phase: {{phase}}</view>
    <view>膝角: {{kneeDeg}}° · validate: {{validateStatus}}</view>
    <view class="place" wx:if="{{placementHint}}">站位: {{placementHint}}</view>
    <view class="fb" wx:if="{{feedbackHint}}">纠错: {{feedbackHint}}</view>
    <view class="err" wx:if="{{errorMsg}}">{{errorMsg}}</view>
    <view class="actions">
      <button size="mini" type="primary" bindtap="toggleDetect" disabled="{{!modelReady && !detecting}}">
        {{detecting ? '停止检测' : '开始检测'}}
      </button>
    </view>
    <view class="tip">应见：绿/黄/红骨骼 + 半透明 Ghost + 站位虚线框</view>
  </view>
</view>
